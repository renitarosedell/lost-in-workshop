# Copy this file to .env and fill in your values.
# Get these from the Azure AI Foundry portal (ai.azure.com).
#
# How to find each value:
#   AZURE_OPENAI_ENDPOINT   - Project overview page → "Endpoint"
#                             Looks like: https://your-hub.openai.azure.com/
#   AZURE_OPENAI_API_KEY    - Project overview page → "Key"
#                             A long hexadecimal string.
#   AZURE_OPENAI_DEPLOYMENT_NAME - Models → Deployments → the name you gave
#                             your gpt-4o-mini deployment (often "gpt-4o-mini").
#
# MCP_SERVER_URL is provided by your workshop facilitator.

AZURE_OPENAI_ENDPOINT=https://your-hub.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o-mini
MCP_SERVER_URL=https://lost-in-raleigh.proudcoast-12345678.eastus2.azurecontainerapps.io/mcp
