# Copy this file to .env and fill in your values.
# Your workshop facilitator will provide the URLs.
# Get the Azure OpenAI values from the Azure AI Foundry portal (ai.azure.com).
#
# How to find each value:
#   AZURE_OPENAI_ENDPOINT        - Project overview page → "Endpoint"
#                                  Looks like: https://your-hub.openai.azure.com/
#   AZURE_OPENAI_API_KEY         - Project overview page → "Key"
#                                  A long hexadecimal string.
#   AZURE_OPENAI_DEPLOYMENT_NAME - Models → Deployments → your gpt-4o-mini deployment name.
#
#   MCP_SERVER_URL   - The Lost in Raleigh game server MCP endpoint (from facilitator).
#   A2A_SERVER_URL   - The Raleigh transport expert A2A endpoint (from facilitator).
#   CITY_GUIDE_URL   - The Raleigh city guide A2A endpoint (from facilitator).

AZURE_OPENAI_ENDPOINT=https://your-hub.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o-mini
MCP_SERVER_URL=https://your-game-server.azurecontainerapps.io/mcp
A2A_SERVER_URL=https://your-a2a-expert.azurecontainerapps.io
CITY_GUIDE_URL=https://your-a2a-expert.azurecontainerapps.io/city-guide
